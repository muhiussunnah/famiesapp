# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# ── Supabase (required) ────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://famies.app
# Extra admin logins besides the built-in one (comma separated)
ADMIN_EMAILS=

# ── Writerfy / Writerify publishing API ────────────────────────────
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the same value in Writerify → Sites → famies.app.
WRITERFY_API_TOKEN=
# Optional: store Writerfy images on Vercel Blob (otherwise Supabase Storage is used)
BLOB_READ_WRITE_TOKEN=

# ── Scheduled publishing cron (Vercel sends it automatically) ──────
CRON_SECRET=

# ── Google (Dashboard analytics, Indexing Report) — optional ───────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:famies.app

# ── IndexNow (Bing, Yandex …) — optional ───────────────────────────
INDEXNOW_KEY=

# ── Rank Tracker (SerpAPI) — optional ──────────────────────────────
SERPAPI_KEY=
SERPAPI_KEY_BACKUP=
SERPAPI_ACCOUNT_CREATED_AT=
SERPAPI_ACCOUNT_CREATED_AT_BACKUP=
