# Local development: copy to .env.local.
# Production (Coolify): docker-compose.yml sets these; Coolify generates
# every password/secret itself (SERVICE_PASSWORD_* variables).

# ── Database (PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgres://famies:famies@127.0.0.1:5432/famies
# DATABASE_SSL=true            # only for a managed Postgres that needs SSL

# ── Admin login (/login → /admin) ──────────────────────────────────
ADMIN_EMAIL=itsinjamul@gmail.com
ADMIN_PASSWORD=
# Signs the session cookie. Long random string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://famies.app
# Where uploaded images are stored (served at /uploads/…)
UPLOAD_DIR=./uploads

# ── Writerify publishing API ───────────────────────────────────────
WRITERFY_API_TOKEN=
# Optional: store Writerify images on Vercel Blob instead of UPLOAD_DIR
BLOB_READ_WRITE_TOKEN=

# ── Scheduled publishing cron (/api/cron/publish-scheduled) ────────
CRON_SECRET=

# ── Google (Dashboard analytics, Indexing Report) — optional ───────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:famies.app

# ── IndexNow (Bing, Yandex …) — optional ───────────────────────────
INDEXNOW_KEY=

# ── Rank Tracker (SerpAPI) — optional ──────────────────────────────
SERPAPI_KEY=
SERPAPI_KEY_BACKUP=
SERPAPI_ACCOUNT_CREATED_AT=
SERPAPI_ACCOUNT_CREATED_AT_BACKUP=
